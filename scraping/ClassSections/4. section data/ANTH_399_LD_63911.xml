<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="63911" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/ANTH/399/63911.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="ANTH" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/ANTH.xml">Anthropology</subject><course id="399" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/ANTH/399.xml">Special Topics</course></parents><sectionNumber>LD </sectionNumber><sectionTitle>Introduction to Genealogy</sectionTitle><creditHours>3 hours</creditHours><statusCode>A</statusCode><sectionText>This course provides a foundational understanding of genealogical research, focusing on the use of historical records and DNA analysis to trace family histories. Students will learn to construct family trees, analyze genealogical evidence, and utilize online databases. The course also explores how genealogical methods can be applied in anthropology to understand cultural patterns and social structures. No prior experience is required, but students should have basic computer skills.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open</enrollmentStatus><startDate>2025-01-21Z</startDate><endDate>2025-05-07Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>11:00 AM</start><end>12:20 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>338</roomNumber><buildingName>Davenport Hall</buildingName><instructors><instructor lastName="David" firstName="L">David, L</instructor></instructors></meeting></meetings></ns2:section>