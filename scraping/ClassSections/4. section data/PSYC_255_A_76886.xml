<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="76886" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/PSYC/255/76886.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="PSYC" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/PSYC.xml">Psychology</subject><course id="255" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/PSYC/255.xml">Decisions &amp; Judgement</course></parents><sectionNumber>A  </sectionNumber><sectionTitle>Decisions &amp; Judgment</sectionTitle><statusCode>A</statusCode><sectionText>Survey of research into human decision making and judgment. Students will learn to apply and test normative, descriptive, and cognitive theories of choice. Through readings and lectures, students will examine topics including optimality, bounded rationality, heuristics &amp; biases, preference reversals, consumer choice, and experience-based decision making.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open</enrollmentStatus><startDate>2025-01-21Z</startDate><endDate>2025-05-07Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>03:30 PM</start><end>04:50 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>142</roomNumber><buildingName>Psychology Building</buildingName><instructors><instructor lastName="Hotaling" firstName="J">Hotaling, J</instructor></instructors></meeting></meetings></ns2:section>