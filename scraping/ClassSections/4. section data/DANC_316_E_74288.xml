<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="74288" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/DANC/316/74288.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="DANC" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/DANC.xml">Dance</subject><course id="316" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/DANC/316.xml">Dancing Techniques Elective</course></parents><sectionNumber>E  </sectionNumber><sectionTitle>Dancing Tech: Iranian Dance</sectionTitle><statusCode>A</statusCode><sectionText>An introduction to the techniques of Iranian dance, providing a cultural context for the various dance practices found within the country, including classical, neo-classical, contemporary, Folkloric, and fusion styles. The course covers a range of Iranian dance vocabulary, including detailed hand and arm movements, fluid traveling steps and turns, and miniature postures. Restricted to Dance majors. Restricted to Undergrad - Urbana-Champaign. THIS COURSE MEETS in 1DANCE-111.</sectionText><sectionNotes>Restricted to Dance or Dance major(s).</sectionNotes><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open (Restricted)</enrollmentStatus><startDate>2025-01-21Z</startDate><endDate>2025-05-07Z</endDate><meetings><meeting id="0"><type code="LAB">Laboratory</type><start>05:00 PM</start><end>06:20 PM</end><daysOfTheWeek>MW     </daysOfTheWeek><roomNumber>SuiteG</roomNumber><buildingName>Storefront Studio</buildingName><instructors><instructor lastName="Amiri" firstName="B">Amiri, B</instructor></instructors></meeting></meetings></ns2:section>