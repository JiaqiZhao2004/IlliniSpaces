<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="34503" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/ENG/199/34503.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="ENG" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/ENG.xml">Engineering</subject><course id="199" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/ENG/199.xml">Undergraduate Open Seminar</course></parents><sectionNumber>ARS</sectionNumber><sectionTitle>ARISE Scholars T&amp;T</sectionTitle><creditHours>1 hours</creditHours><statusCode>A</statusCode><sectionText>Students will learn about Trinidad and Tobago's cultural heritage and unique history through discussions of conservation, community-development, and cultural intelligence. Students will engage in a real-time service projects with local NGOs focusing on community-driven initiatives. The overall theme of this global classroom is cultural identity and resilience. This course includes an optional travel to Trinidad and Tobago in May.  This course will be held in 2320 Digital Computer Lab.</sectionText><sectionNotes>Restricted to Undergrad - Urbana-Champaign.</sectionNotes><sectionCappArea>Restricted to Engineering ARISE Program students.</sectionCappArea><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open (Restricted)</enrollmentStatus><startDate>2025-01-21Z</startDate><endDate>2025-05-07Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>04:00 PM</start><end>05:20 PM</end><daysOfTheWeek>W      </daysOfTheWeek><roomNumber>0036</roomNumber><buildingName>Campus Instructional Facility</buildingName><instructors><instructor lastName="Montagner Martin