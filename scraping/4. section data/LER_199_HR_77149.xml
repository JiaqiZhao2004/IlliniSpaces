<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="77149" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/LER/199/77149.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="LER" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/LER.xml">Labor and Employment Relations</subject><course id="199" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/LER/199.xml">Undergraduate Open Seminar</course></parents><sectionNumber>HR </sectionNumber><sectionTitle>Intro to Human Resources</sectionTitle><creditHours>3 hours</creditHours><statusCode>A</statusCode><sectionText>Topic: Introduction to Human Resources Introduces students to the study and profession of human resources, and trends in human resources management. Students will learn an overview of key concepts in HR including employment law; talent recruitment and selection, training and development; employee performance and evaluation; compensation structures and strategies; role and impact of labor relations and collective bargaining, and the role HR plays within large global to small rural organizations.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open</enrollmentStatus><startDate>2025-01-21Z</startDate><endDate>2025-05-07Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>02:00 PM</start><end>03:20 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>53</roomNumber><buildingName>Inst Labor &amp;  Industrial Rel</buildingName><instructors><instructor lastName="Neighbors" firstName="B">Neighbors, B</instructor></instructors></meeting></meetings></ns2:section>