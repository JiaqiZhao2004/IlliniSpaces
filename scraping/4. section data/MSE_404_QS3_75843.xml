<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="75843" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/MSE/404/75843.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="MSE" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/MSE.xml">Materials Science and Engineering</subject><course id="404" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/MSE/404.xml">Laboratory Studies in Materials Science and Engineering</course></parents><sectionNumber>QS3</sectionNumber><sectionTitle>Quantum States</sectionTitle><sectionDateRange>Meets 17-Mar-25 - 07-May-25.</sectionDateRange><statusCode>A</statusCode><sectionText>Module 2:  Coherent control of quantum states of the NV- defect in diamond. In this lab module, students will study the control of the quantum states of an ensemble of NV- defects in diamond, use pulsed sequences to determine the longitudinal and transverse relaxation times of the defect, and design pulse sequences to control the sensitivity of the NV- defect to temperature and magnetic field.</sectionText><partOfTerm>B</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open (Restricted)</enrollmentStatus><startDate>2025-03-17Z</startDate><endDate>2025-05-07Z</endDate><meetings><meeting id="0"><type code="B5 ">Laboratory</type><start>08:00 AM</start><end>10:50 AM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>215N</roomNumber><meetingDateRange>Meets 17-Mar-25 - 07-May-25.</meetingDateRange><buildingName>Ceramics Building</buildingName><instructors><instructor lastName="Cahill" firstName="D">Cahill, D</instructor></instructors></meeting></meetings></ns2:section>