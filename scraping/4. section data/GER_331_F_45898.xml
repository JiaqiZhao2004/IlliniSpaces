<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="45898" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/GER/331/45898.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="GER" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/GER.xml">German</subject><course id="331" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/GER/331.xml">Intro to German Literature</course></parents><sectionNumber>F  </sectionNumber><creditHours>3 hours</creditHours><statusCode>A</statusCode><sectionText>Exploration of German culture, history, and literature from the late eighteenth century (Enlightenment) to the present. Our texts engage with reason and madness, love and sexuality, technology and modernization, justice and guilt, community and identity. To better understand the historical and cultural contexts in which these texts were produced, we will draw on paintings, photography, philosophy, social and political history, and film.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open</enrollmentStatus><startDate>2025-01-21Z</startDate><endDate>2025-05-07Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>12:00 PM</start><end>01:20 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>1134</roomNumber><buildingName>Literatures, Cultures, &amp; Ling</buildingName><instructors><instructor lastName="Meyer" firstName="M">Meyer, M</instructor></instructors></meeting></meetings></ns2:section>