<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="HORT 223" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/HORT/223.xml"><parents><calendarYear id="2025" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025.xml">2025</calendarYear><term id="120251" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring.xml">Spring 2025</term><subject id="HORT" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/HORT.xml">Horticulture</subject></parents><label>The Intelligent Behavior of Plants</label><description>This course provides students with an introduction into the study of plant behavior, which focuses on how plants interact with and respond to the world around them. Topics include a basic overview of plant anatomy and physiology, a comparative examination of behavioral and communication mechanisms used by plants and animals, and an analysis of the controversial arguments regarding plant intelligence.</description><creditHours>3 hours.</creditHours><genEdCategories><category id="NAT"><description>Natural Sciences &amp; Technology</description><ns2:genEdAttributes><genEdAttribute code="1LS">Nat Sci &amp; Tech - Life Sciences</genEdAttribute></ns2:genEdAttributes></category><category id="ACP"><description>Advanced Composition</description><ns2:genEdAttributes><genEdAttribute code="1CLL">Advanced Composition</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="68723" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/HORT/223/68723.xml">A  </section><section id="76875" href="https://courses.illinois.edu/cisapp/explorer/schedule/2025/spring/HORT/223/76875.xml">CHP</section></sections></ns2:course>